        {
          "id": "9bb47677-862e-4f13-82ac-6d3bc4eb4936",
          "name": "List CVEs",
          "request": {
            "name": "List CVEs",
            "description": {
              "content": "Returns a list of recent CVEs affecting Red Hat products. Supports filtering by date range, severity, product, and CVE identifiers. Returns the first page of 1000 results by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cve.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<date>",
                  "description": "Return CVEs before this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<date>",
                  "description": "Return CVEs after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "Filter by Red Hat product name (e.g., \"Red Hat Enterprise Linux 9\")"
                },
                {
                  "disabled": false,
                  "key": "severity",
                  "value": "<string>",
                  "description": "Filter by severity level"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "1000",
                  "description": "Number of results per page (default 1000)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
